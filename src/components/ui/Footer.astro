---
// Footer
// ------------
// Description: the website footer is the section of content



// Data
import { footerNavigationData } from '../../config/footerNavigation'

const { footerAbout, footerColumns, subFooter } = footerNavigationData
---

<footer class="footer">
	<!-- Main footer -->
	<div class="footer__main">
		<div class="footer__container">
			<div class="footer__cols">
				<div class="footer__col">
					<a
						aria-label="website logo"
						aria-current="page"
						class="footer__main-brand"
						href="/"
					>
						<img
							src={footerAbout.logo.src}
							alt={footerAbout.logo.alt}
							width="32"
							height="32"
						/>
						{footerAbout.logo.text}
					</a>
					<p class="mb-2">
						{footerAbout.aboutTextTitle}
					</p>
					<p class="mb-4">
						{footerAbout.aboutTextDesc}
					</p>
					<ul class="mt-4 mb-5 flex flex-col gap-3 text-sm font-medium text-neutral-300">
						<!-- Facebook -->
						<li>
							<a href="https://www.facebook.com/congresoestudiantespsicologia" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-white transition-colors">
								<div class="flex items-center justify-center w-7 h-7 rounded-full bg-[#1877F2]">
									<svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
								</div>
								congresoestudiantespsicologia
							</a>
						</li>
						<!-- Instagram -->
						<li>
							<a href="https://www.instagram.com/caepperu" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-white transition-colors">
								<div class="flex items-center justify-center w-7 h-7 rounded-full bg-[#E4405F]">
									<svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path></svg>
								</div>
								caepperu
							</a>
						</li>
						<!-- WhatsApp -->
						<li>
							<a href="https://api.whatsapp.com/send?phone=+51936202205&text=Hola%20CAEP%20quiero%20inscribirme%20en%20el%20congreso" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-white transition-colors">
								<div class="flex items-center justify-center w-7 h-7 rounded-full bg-[#25D366]">
									<svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
								</div>
								+(51) 936202205
							</a>
						</li>
						<!-- Web -->
						<li>
							<a href="https://caepperu.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-white transition-colors">
								<div class="flex items-center justify-center w-7 h-7 rounded-full bg-[#8B5CF6]">
									<svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
								</div>
								https://caepperu.com
							</a>
						</li>
						<!-- TikTok -->
						<li>
							<a href="https://www.tiktok.com/@vivecaep" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-white transition-colors">
								<div class="flex items-center justify-center w-7 h-7 rounded-full bg-[#000000]">
									<svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93v7.2c0 1.96-.5 3.96-1.66 5.49-1.15 1.5-2.82 2.5-4.66 2.89-1.85.4-3.84.18-5.5-.68-1.66-.86-3.03-2.31-3.69-4.06-.65-1.74-.63-3.72.08-5.46.7-1.74 2.1-3.17 3.82-3.86 1.72-.69 3.68-.7 5.42-.04v4.06c-.73-.25-1.55-.26-2.29-.02-.73.24-1.37.74-1.77 1.4-.41.65-.54 1.45-.37 2.19.18.73.65 1.38 1.28 1.77.64.4 1.42.54 2.16.38.74-.15 1.4-.6 1.81-1.22.42-.62.58-1.4.45-2.14V.02z"></path></svg>
								</div>
								@vivecaep
							</a>
						</li>
					</ul>
				</div>
				{
					footerColumns.map((column) => (
						<div class="footer__col">
							<h3>{column.category}</h3>
							<ul>
								{column.subCategories.map((subCategory) => (
									<li>
										<a href={subCategory.subCategoryLink}>
											{' '}
											{subCategory.subCategory}{' '}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</div>
	<!-- Sub Footer -->
	<div class="footer__sub">
		<div class="footer__container">
			<div class="footer__sub-cols">
				<div class="footer__sub-col">{subFooter.copywriteText}</div>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer {
		@apply text-neutral-300/90;
	}
	.footer a {
		@apply transition-colors duration-300 hover:text-white focus:text-white;
	}
	.footer__main {
		@apply border-t border-[#3b1778]/30 bg-[#1a0b2e] pb-12 pt-16 text-sm [&_li]:mb-2 [&_li]:leading-6;
	}
	.footer__main h3 {
		@apply mb-6 text-base font-bold leading-8 tracking-wider text-white;
	}
	.footer__main-brand {
		@apply mb-6 flex items-center gap-2 whitespace-nowrap font-headings text-xl font-extrabold leading-6 text-white focus:outline-none;
	}
	.footer__container {
		@apply container mx-auto px-6;
	}

	.footer__cols {
		@apply grid grid-cols-4 gap-6 md:grid-cols-8 lg:grid-cols-12;
	}

	.footer__col {
		@apply col-span-2 first:col-span-4 md:col-span-4 md:first:col-span-8 lg:col-span-2 lg:first:col-span-6 lg:first:max-w-96;
	}
	.footer__sub {
		@apply border-t border-[#3b1778]/50 bg-[#120424] py-4 text-sm text-neutral-400;
	}
	.footer__sub ul {
		@apply flex items-center justify-end gap-6;
	}
	.footer__sub a {
		@apply transition-colors duration-300 hover:text-white [&_svg]:h-5 [&_svg]:w-5 [&_svg]:shrink-0;
	}
	.footer__sub-cols {
		@apply grid grid-cols-4 items-center gap-6 md:grid-cols-8 lg:grid-cols-12;
	}

	.footer__sub-col {
		@apply col-span-2 md:col-span-4 lg:col-span-6;
	}
</style>
