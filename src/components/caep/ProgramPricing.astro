			{ time: '15:00 – 16:00', title: 'Ponencia 6', icon: '🎤' },
			{ time: '16:30 – 17:30', title: 'Ponencia 7', icon: '🎤' },
			{ time: '18:00 – 19:00', title: 'Ponencia 8', icon: '🎤' },
