		]
	},
	{
		day: 'Día 4',
		date: 'Jue 17 Set',
		title: 'Actividades sociales + integración',
		color: '#00695c',
		events: [
			{ time: '10:30 – 11:30', title: 'Ponencia Estudiantil 14', icon: '🎓' },
			{ time: '12:00 – 13:00', title: 'Ponencia 15', icon: '🎤' },
			{ time: '13:00', title: 'Receso', icon: '☕' },
			{ time: '15:00 – 16:00', title: 'Ponencia 16', icon: '🎤' },
			{ time: '16:30 – 17:30', title: 'Ponencia 17', icon: '🎤' },
			{ time: '18:00 – 19:00', title: 'Ponencia 18', icon: '🎤' },
			{ time: '21:00', title: 'Fiesta de Clausura', icon: '🏆' }
		]
	},
	{
		day: 'Día 5',
		date: 'Vie 18 Set',
		title: 'Clausura + despedida',
		color: '#e65100',
		events: [{ time: 'Todo el día', title: 'Reto CAEP – Día Deportivo (Opcional)', icon: '🏃' }]
	}
]

let apiPlans: any[] = []
try {
	const res = await fetch(`${import.meta.env.PUBLIC_API_URL}/plans/list`)
	if (res.ok) {
		const data = await res.json()
		apiPlans = data.plans || []
	}
} catch (error) {
	console.error('Error al obtener los planes:', error)
}

const planStyles: Record<string, any> = {
	'Individual': {
		type: 'Individual',
		description: 'Pase general para 1 persona',
		subDescription: '* Precio por persona',
		bgClass: 'bg-gradient-to-br from-[#4a148c] to-[#2c1065]',
		textClass: 'text-white',
		priceClass: 'text-white',
		btnClass: 'bg-[#fbc02d] text-[#4a148c] hover:bg-yellow-500'
	},
	'Grupo de 10': {
		type: 'Grupo de 10+',
		description: 'Mejor tarifa para delegaciones',
		subDescription: '* Precio por persona',
		bgClass: 'bg-gradient-to-br from-[#d32f2f] to-[#b71c1c]',
		textClass: 'text-white',
		priceClass: 'text-white',
		btnClass: 'bg-[#fbc02d] text-[#4a148c] hover:bg-yellow-500'
	},
	'Grupo de 5': {
		type: 'Grupo de 5',
		description: 'Ideal para grupos de amigos',
		subDescription: '* Precio por persona',
		bgClass: 'bg-gradient-to-br from-[#fbc02d] to-[#f9a825]',
		textClass: 'text-[#4a148c]',
		priceClass: 'text-[#4a148c]',
		btnClass: 'bg-[#d32f2f] text-white hover:bg-red-700'
	}
}

// Solo mostrar los planes activos que devuelve la lista de planes de la API
const pricing = apiPlans.length > 0
	? apiPlans.map((plan: any) => {
		const style = planStyles[plan.name] || {
			type: plan.name,
			description: plan.description || 'Pase para el congreso',
			subDescription: '* Precio por persona',
			bgClass: 'bg-gradient-to-br from-[#4a148c] to-[#2c1065]',
			textClass: 'text-white',
			priceClass: 'text-white',
			btnClass: 'bg-[#fbc02d] text-[#4a148c] hover:bg-yellow-500'
		}
		return {
			...style,
			apiName: plan.name,
			price: parseInt(plan.price).toString(),
			btnText: '¡Inscríbete ya!'
		}
	})
	: [
		{
			type: 'Individual',
			apiName: 'Individual',
			description: 'Pase general para 1 persona',
			subDescription: '* Precio por persona',
			price: '150',
			btnText: '¡Inscríbete ya!',
			bgClass: 'bg-gradient-to-br from-[#4a148c] to-[#2c1065]',
			textClass: 'text-white',
			priceClass: 'text-white',
			btnClass: 'bg-[#fbc02d] text-[#4a148c] hover:bg-yellow-500'
		},
		{
			type: 'Grupo de 10+',
			apiName: 'Grupo de 10',
			description: 'Mejor tarifa para delegaciones',
			subDescription: '* Precio por persona',
			price: '140',
			btnText: '¡Inscríbete ya!',
			bgClass: 'bg-gradient-to-br from-[#d32f2f] to-[#b71c1c]',
			textClass: 'text-white',
			priceClass: 'text-white',
			btnClass: 'bg-[#fbc02d] text-[#4a148c] hover:bg-yellow-500'
		}
	]
