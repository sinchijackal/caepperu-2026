		--detail-shadow-hover: rgba(74, 20, 140, 0.12);
		--detail-scroll-thumb: #d8c5ff;
		--detail-scroll-thumb-hover: #c0a9ff;
	}

	:global(.dark) :root {
		--detail-card-bg: rgba(255, 255, 255, 0.05);
		--detail-card-border: rgba(255, 255, 255, 0.3);
