		date: 'Mié 16 Set',
		title: 'Networking',
		color: '#283593',
		events: [
			{ time: '10:30 – 11:30', title: 'Ponencia Estudiantil 9', icon: '🎓' },
			{ time: '12:00 – 13:00', title: 'Ponencia 10', icon: '🎤' },
			{ time: '13:00', title: 'Receso', icon: '☕' },
