<script
	is:inline
	define:vars={{
		programData: programDays.map((d) => ({
			day: d.day,
			date: d.date,
			color: d.color,
			events: d.events
		})),
		apiUrl: import.meta.env.PUBLIC_API_URL
	}}
>
	const data = programData

	function setupProgramPricing() {
		const master = document.getElementById('program-master')
		const detail = document.getElementById('program-detail')
		const backBtn = document.getElementById('program-back')
		const detailHeader = document.getElementById('detail-header')
		const detailDayLabel = document.getElementById('detail-day-label')
		const detailDayDate = document.getElementById('detail-day-date')
		const detailEvents = document.getElementById('detail-events')

		if (!master || !detail || !backBtn) return

		function showDetail(idx) {
			const day = data[idx]

			// Set the line color variable dynamically
			const isDark = document.documentElement.classList.contains('dark')
			const lineColor = isDark ? 'rgba(255, 255, 255, 0.2)' : `${day.color}40`
			detailEvents.style.setProperty('--detail-timeline-line', lineColor)

			detailHeader.style.background = `linear-gradient(135deg, ${day.color}, ${day.color}cc)`
			detailDayLabel.textContent = day.day
			detailDayDate.textContent = day.date

			detailEvents.innerHTML = `
				<div style="position:relative">
					<!-- Vertical timeline line: behind circles -->
					<div style="position:absolute;left:21px;top:0;bottom:0;width:2px;background:var(--detail-timeline-line);z-index:0"></div>

					${day.events
						.map(
							(e, i) => `
					<div class="detail-event-item" style="
						display:flex;align-items:flex-start;gap:14px;
						margin-bottom:14px;position:relative;
						opacity:0;transform:translateX(20px);
						animation:slideIn .35s ease forwards;
						animation-delay:${i * 60}ms
					">
						<!-- Icon circle -->
						<div style="
							width:42px;height:42px;border-radius:50%;flex-shrink:0;
							background:var(--detail-card-bg);
							border:1.5px solid ${day.color}35;
							display:flex;align-items:center;justify-content:center;
							font-size:1.2rem;
							position:relative;z-index:1;
							box-shadow:0 0 0 4px ${day.color}10
						">${e.icon}</div>

						<!-- Content card -->
						<div class="detail-event-card" style="
							flex:1;background:var(--detail-card-bg);border-radius:14px;
							border:1px solid var(--detail-card-border);
							padding:10px 14px;
							box-shadow:0 2px 8px var(--detail-shadow);
							transition:transform .2s,box-shadow .2s;
						">
							<p style="margin:0;font-size:.875rem;font-weight:700;color:var(--detail-text-color);letter-spacing:-.01em">${e.title}</p>
							<span style="
								display:inline-block;margin-top:5px;
								font-size:.7rem;font-weight:600;
								background:${day.color}18;color:${day.color};
								padding:2px 9px;border-radius:999px;
								border:1px solid ${day.color}30
							">🕐 ${e.time}</span>
						</div>
					</div>
					`
						)
						.join('')}
				</div>
			`

			const sliderHeight = master.scrollHeight
			detail.style.minHeight = sliderHeight + 'px'

			detail.style.visibility = 'visible'
			master.style.transform = 'translateX(-100%)'
			detail.style.transform = 'translateX(0)'
		}

		function showMaster() {
			master.style.transform = 'translateX(0)'
			detail.style.transform = 'translateX(100%)'
			setTimeout(() => {
				if (master.style.transform === 'translateX(0px)' || master.style.transform === 'translateX(0)') {
					detail.style.visibility = 'hidden'
				}
			}, 400)
		}

		document.querySelectorAll('.program-day-btn').forEach((btn) => {
			btn.addEventListener('click', () => showDetail(Number(btn.dataset.day)))
		})

		backBtn.addEventListener('click', showMaster)
	}

	// Fetch dinámico de precios en el cliente (para que varíen sin reconstruir el sitio estático)
	const updatePrices = async () => {
		try {
			const res = await fetch(`${apiUrl}/plans/list`)
			if (res.ok) {
				const data = await res.json()
				const plans = data.plans || []

				document.querySelectorAll('[data-plan-name]').forEach((el) => {
					const apiName = el.getAttribute('data-plan-name')
					const plan = plans.find((p) => p.name === apiName)
					if (plan) {
						el.textContent = parseInt(plan.price).toString()
					}
				})
			}
		} catch (error) {
			console.error('Error fetching dynamic plans client-side:', error)
		}
	}

	// Inicialización
	const init = () => {
		setupProgramPricing()
		updatePrices()
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init)
	} else {
		init()
	}

	// Soporte para Astro ClientRouter / ViewTransitions
	document.addEventListener('astro:page-load', init)
</script>

