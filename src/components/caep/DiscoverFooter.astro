---
// src/components/caep/DiscoverFooter.astro
const testimonials = [
  {
    rating: 5,
    quote: '"El mejor evento académico al que he asistido"'
  },
  {
    rating: 5,
    quote: '"Me ayudó a encontrar mi camino profesional"'
  }
];
---
<section class="relative min-h-[500px] flex items-stretch [content-visibility:auto] contain-intrinsic-size-1000">
  <!-- Background Image full width -->
  <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1587595431973-160d0d94add1?q=80&w=2076&auto=format&fit=crop');"></div>
  
  <!-- Gradient overlays to match the design (heavy purple on left, transparent on right) -->
  <div class="absolute inset-0 bg-gradient-to-r from-[#2c1065] from-0% via-[#4a148c]/80 via-40% to-transparent to-80%"></div>

  <div class="container mx-auto px-4 relative z-10 flex flex-col md:flex-row py-16">
    
    <!-- Left Column: Testimonials -->
    <div class="w-full md:w-1/2 flex flex-col justify-center pr-8">
      <div class="flex items-center justify-center mb-10">
        <div class="h-1 flex-grow -translate-y-1 rounded-full bg-gradient-to-r from-transparent via-purple-700 to-purple-400"></div>
        <h2 class="px-6 text-center text-2xl md:text-3xl font-bold leading-none text-white">
          Lo que dicen del CAEP
        </h2>
        <div class="h-1 flex-grow -translate-y-1 rounded-full bg-gradient-to-r from-purple-400 via-purple-700 to-transparent"></div>
      </div>

      <div class="space-y-4 max-w-md">
        {testimonials.map((test) => (
          <div class="bg-[#3b1778]/85 border border-white/10 rounded-xl p-5 shadow-lg">
            <div class="flex text-[#fbc02d] mb-2">
              {[...Array(test.rating)].map(() => (
                 <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
              ))}
            </div>
            <p class="text-white/90 italic font-medium">
              {test.quote}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Column: Descubre Cusco Header -->
    <div class="w-full md:w-1/2 flex items-center justify-center md:justify-end mt-12 md:mt-0">
      <div class="group relative cursor-pointer inline-flex items-center justify-center p-[2px] rounded-full overflow-hidden shadow-[0_0_20px_rgba(216,180,254,0.3)] transition-transform duration-300 hover:scale-105">
        <!-- Static Glow instead of spinning gradient -->
        <div class="absolute inset-0 bg-gradient-to-r from-purple-400 to-purple-600 opacity-50"></div>
        
        <!-- Delicate Glass Badge Content -->
        <div class="relative bg-black/90 rounded-full px-6 py-3 md:px-8 md:py-4 flex items-center gap-3 transition-colors group-hover:bg-black/80 h-full w-full">
          <svg class="w-5 h-5 md:w-6 md:h-6 text-purple-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          <h2 class="text-xl md:text-2xl font-bold tracking-widest uppercase bg-gradient-to-r from-purple-200 to-white bg-clip-text text-transparent drop-shadow-md">
            Descubre Cusco
          </h2>
        </div>
      </div>
    </div>
    
  </div>
</section>
