---
// src/components/caep/MissionVisionGallery.astro
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/events/*.{jpeg,jpg,png,gif}', { eager: true });
const photos = Object.values(imageFiles).map(file => file.default).slice(0, 8);
---

<section id="nosotros" class="relative border-b-8 border-[#3b1778] bg-white dark:bg-[#190d27] py-20 transition-colors duration-300">
  <!-- Decoraciones de fondo -->
  <div class="pointer-events-none absolute left-0 top-0 h-full w-full overflow-hidden">
    <div class="absolute -left-20 -top-20 h-64 w-64 rounded-full bg-purple-200 opacity-20 blur-3xl dark:bg-purple-900 dark:opacity-40"></div>
    <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-orange-200 opacity-20 blur-3xl dark:bg-orange-900 dark:opacity-30"></div>
  </div>

  <div class="container relative mx-auto px-4">
    
    <!-- Header -->
    <div class="mx-auto mb-16 flex max-w-5xl items-center justify-center">
      <div class="h-1 flex-grow -translate-y-1 rounded-full bg-gradient-to-r from-transparent via-purple-200 to-purple-400 dark:via-purple-800 dark:to-purple-500"></div>
      <h2 class="px-6 text-center text-4xl font-extrabold leading-none tracking-tight text-[#4a148c] dark:text-white md:text-5xl">
        Nuestro Propósito
      </h2>
      <div class="h-1 flex-grow -translate-y-1 rounded-full bg-gradient-to-r from-purple-400 via-purple-200 to-transparent dark:from-purple-500 dark:via-purple-800"></div>
    </div>

    <!-- Misión y Visión Cards -->
    <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2">
      <!-- Misión -->
      <div class="group relative rounded-2xl bg-white/50 p-8 pt-12 shadow-[0_8px_30px_rgb(0,0,0,0.04)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)] dark:bg-[#2a1744]/50 dark:shadow-[0_8px_30px_rgb(0,0,0,0.2)] dark:hover:shadow-[0_20px_40px_rgb(103,58,183,0.15)] border border-purple-100/50 dark:border-purple-800/30">
        <div class="absolute -top-6 left-8 flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br from-[#4a148c] to-[#7b1fa2] text-white shadow-lg transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </div>
        <h3 class="mb-4 text-2xl font-bold text-[#4a148c] dark:text-purple-300">Misión</h3>
        <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300">
          Crear una experiencia formativa integral que conecte a estudiantes de psicología de todo el Perú con los avances más relevantes de la disciplina, a través de conferencias, talleres y espacios vivenciales que impulsen su crecimiento académico, profesional y humano.
        </p>
      </div>

      <!-- Visión -->
      <div class="group relative rounded-2xl bg-white/50 p-8 pt-12 shadow-[0_8px_30px_rgb(0,0,0,0.04)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)] dark:bg-[#2a1744]/50 dark:shadow-[0_8px_30px_rgb(0,0,0,0.2)] dark:hover:shadow-[0_20px_40px_rgb(103,58,183,0.15)] border border-purple-100/50 dark:border-purple-800/30">
        <div class="absolute -top-6 left-8 flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br from-[#ff8f00] to-[#ffb300] text-white shadow-lg transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
        </div>
        <h3 class="mb-4 text-2xl font-bold text-[#ff8f00] dark:text-[#ffb300]">Visión</h3>
        <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300">
          Ser el congreso estudiantil de psicología más influyente del Perú, reconocido por transformar la manera en que los futuros profesionales aprenden, se conectan y se proyectan dentro de la disciplina.
        </p>
      </div>
    </div>

    <!-- Frase Corta -->
    <div class="mx-auto mt-16 max-w-4xl text-center">
      <blockquote class="relative inline-block text-2xl font-medium italic text-gray-800 dark:text-purple-100 md:text-3xl">
        <span class="absolute -left-8 -top-4 text-5xl text-purple-300 opacity-50 dark:text-purple-600">"</span>
        Más que un congreso, una experiencia que transforma.
        <span class="absolute -bottom-8 -right-8 text-5xl text-purple-300 opacity-50 dark:text-purple-600">"</span>
      </blockquote>
    </div>

    <!-- Galería de 8 Fotos -->
    <div class="mt-24">
      <div class="mx-auto mb-10 flex max-w-3xl items-center justify-center">
        <h3 class="text-center text-3xl font-bold text-[#4a148c] dark:text-white">
          Momentos Inolvidables
        </h3>
      </div>
      
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
        <!-- Usando las primeras 8 fotos de events -->
        {photos.map((photo, index) => (
          <div class="gallery-item cursor-pointer group relative aspect-square overflow-hidden rounded-2xl shadow-md transition-all duration-500 hover:shadow-xl">
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 z-10 flex items-center justify-center">
              <div class="translate-y-4 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
                <svg class="h-12 w-12 text-white/90 drop-shadow-lg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>
              </div>
            </div>
            <Image 
              src={photo} 
              alt={`Momento CAEP ${index + 1}`} 
              class="gallery-image h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- Image Modal -->
<div id="image-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/95 p-4 opacity-0 pointer-events-none transition-opacity duration-300 backdrop-blur-sm">
  <!-- Close Button -->
  <button id="close-modal" class="absolute top-6 right-6 text-white/70 hover:text-white transition-colors p-2 focus:outline-none z-50">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
  </button>
  
  <!-- Navigation Arrows -->
  <button id="prev-btn" class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 text-white/50 hover:text-white hover:bg-white/10 rounded-full transition-all p-2 focus:outline-none z-50">
    <svg class="w-10 h-10 md:w-12 md:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
  </button>
  <button id="next-btn" class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 text-white/50 hover:text-white hover:bg-white/10 rounded-full transition-all p-2 focus:outline-none z-50">
    <svg class="w-10 h-10 md:w-12 md:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
  </button>

  <div class="relative max-h-[90vh] max-w-5xl w-full flex justify-center items-center scale-95 transition-transform duration-300" id="modal-content">
    <img id="modal-image" src="" alt="Vista ampliada" class="max-h-[90vh] w-auto max-w-full rounded-lg shadow-2xl object-contain border border-white/10 transition-opacity duration-200" />
  </div>
</div>

<script>
  const setupGallery = () => {
    const galleryItems = document.querySelectorAll('.gallery-item');
    const modal = document.getElementById('image-modal');
    const modalImage = document.getElementById('modal-image') as HTMLImageElement;
    const closeModalBtn = document.getElementById('close-modal');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const modalContent = document.getElementById('modal-content');

    if (!modal || !modalImage || !modalContent) return;

    // Guardar las rutas de las imágenes en un array para navegar
    const imageUrls = Array.from(galleryItems).map(item => {
      const img = item.querySelector('.gallery-image') as HTMLImageElement;
      return img ? img.src : '';
    }).filter(src => src !== '');

    let currentIndex = 0;

    const updateImage = (index: number) => {
      // Efecto suave al cambiar de foto
      modalImage.style.opacity = '0';
      setTimeout(() => {
        modalImage.src = imageUrls[index];
        modalImage.style.opacity = '1';
      }, 150);
    };

    const openModal = (index: number) => {
      if (index < 0 || index >= imageUrls.length) return;
      currentIndex = index;
      modalImage.src = imageUrls[currentIndex];
      modalImage.style.opacity = '1';
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalContent.classList.remove('scale-100');
      modalContent.classList.add('scale-95');
      document.body.style.overflow = '';
    };

    const showNext = () => {
      currentIndex = (currentIndex + 1) % imageUrls.length;
      updateImage(currentIndex);
    };

    const showPrev = () => {
      currentIndex = (currentIndex - 1 + imageUrls.length) % imageUrls.length;
      updateImage(currentIndex);
    };

    galleryItems.forEach((item, index) => {
      // Evitar eventos duplicados al recargar el script
      const newItem = item.cloneNode(true) as HTMLElement;
      item.parentNode?.replaceChild(newItem, item);
      
      newItem.addEventListener('click', () => openModal(index));
    });

    // Reasignar eventos a botones
    if (closeModalBtn) {
      const newCloseBtn = closeModalBtn.cloneNode(true);
      closeModalBtn.parentNode?.replaceChild(newCloseBtn, closeModalBtn);
      newCloseBtn.addEventListener('click', closeModal);
    }

    if (prevBtn) {
      const newPrevBtn = prevBtn.cloneNode(true);
      prevBtn.parentNode?.replaceChild(newPrevBtn, prevBtn);
      newPrevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        showPrev();
      });
    }

    if (nextBtn) {
      const newNextBtn = nextBtn.cloneNode(true);
      nextBtn.parentNode?.replaceChild(newNextBtn, nextBtn);
      newNextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        showNext();
      });
    }
    
    // Cerrar al hacer clic en el fondo oscuro
    modal.addEventListener('click', (e) => {
      if (e.target === modal || e.target === modalContent) {
        closeModal();
      }
    });

    // Navegación por teclado global
    const handleKeyDown = (e: KeyboardEvent) => {
      if (modal.classList.contains('opacity-0')) return;
      
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    };

    // Limpiar listener anterior para evitar fugas de memoria y llamadas múltiples
    if ((window as any).galleryKeyHandler) {
      document.removeEventListener('keydown', (window as any).galleryKeyHandler);
    }
    (window as any).galleryKeyHandler = handleKeyDown;
    document.addEventListener('keydown', handleKeyDown);
  };

  // Inicializar
  setupGallery();
  document.addEventListener('astro:page-load', setupGallery);
</script>
