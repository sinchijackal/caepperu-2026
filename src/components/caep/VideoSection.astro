---
// src/components/caep/VideoSection.astro
---

<section
	class="relative overflow-hidden bg-gradient-to-br from-[#1a0b2e] via-[#3b1778] to-[#1a0b2e] py-20 [content-visibility:auto]"
>
	<!-- Decorative starry background effect using CSS -->
	<div
		class="absolute inset-0 opacity-30"
		style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 50px 50px;"
	>
	</div>

	<div class="container relative z-10 mx-auto px-4">
		<div class="mx-auto mb-12 flex max-w-5xl items-center justify-center">
			<div
				class="h-1 flex-grow -translate-y-1 rounded-full bg-gradient-to-r from-transparent via-purple-700 to-purple-400"
			>
			</div>
			<h2 class="px-6 text-center text-3xl font-bold leading-none text-white md:text-4xl">
				Así se vive el CAEP
			</h2>
			<div
				class="h-1 flex-grow -translate-y-1 rounded-full bg-gradient-to-r from-purple-400 via-purple-700 to-transparent"
			>
			</div>
		</div>

		<p class="mx-auto mb-12 max-w-2xl text-center text-lg font-light text-white/70">
			Cada edición deja huella. Vive momentos que van <span
				class="font-semibold text-white/95">más allá del aula</span
			>.
		</p>

		<div class="mx-auto flex max-w-6xl flex-col items-center gap-12 lg:flex-row">
			<!-- Video Player Button -->
			<button
				id="open-video-btn"
				class="group relative w-full overflow-hidden rounded-2xl border-4 border-white/10 shadow-2xl lg:w-3/5 text-left focus:outline-none focus:ring-4 focus:ring-purple-400"
				aria-label="Reproducir video del evento"
			>
				<img
					src="https://img.youtube.com/vi/zYq7zPa_Cl0/maxresdefault.jpg"
					alt="CAEP Event Video"
					class="aspect-video w-full object-cover transition-transform duration-700 group-hover:scale-105"
				/>
				<div
					class="absolute inset-0 flex items-center justify-center bg-black/40 transition-colors group-hover:bg-black/30"
				>
					<div
						class="flex h-20 w-20 items-center justify-center rounded-full bg-white/90 shadow-lg backdrop-blur-sm transition-transform duration-300 group-hover:scale-110"
					>
						<svg
							class="ml-1 h-10 w-10 text-[#4a148c]"
							fill="currentColor"
							viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg
						>
					</div>
				</div>
			</button>

			<!-- Video Modal -->
			<dialog id="video-modal" class="backdrop:bg-black/80 backdrop:backdrop-blur-sm bg-transparent w-full max-w-5xl rounded-2xl p-0 shadow-2xl m-auto focus:outline-none">
				<div class="relative w-full aspect-video bg-black rounded-2xl overflow-hidden shadow-2xl border border-white/20">
					<!-- Loading Spinner -->
					<div id="video-loader" class="absolute inset-0 flex items-center justify-center bg-black z-0">
						<div class="h-12 w-12 animate-spin rounded-full border-4 border-white/20 border-t-purple-500"></div>
					</div>
					
					<button id="close-video-btn" class="absolute top-4 right-4 text-white bg-black/50 hover:bg-black/80 rounded-full focus:outline-none z-20 p-2 transition-colors" aria-label="Cerrar video">
						<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
					</button>
					<iframe
						id="youtube-iframe"
						class="relative z-10 w-full h-full opacity-0 transition-opacity duration-500 border-0"
						src=""
						title="YouTube video player"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					></iframe>
				</div>
			</dialog>

			<!-- Testimonials bubbles -->
			<div class="flex w-full flex-col gap-6 lg:w-2/5">
				<div
					class="relative max-w-[85%] self-start rounded-t-2xl rounded-br-2xl border border-white/20 bg-white/10 p-4 italic text-white/90 shadow-xl"
				>
					"Aquí conocí personas que hoy son parte de mi vida profesional"
				</div>
				<div
					class="relative max-w-[85%] self-end rounded-t-2xl rounded-bl-2xl border border-[#5e35b1]/50 bg-[#3b1778]/60 p-4 italic text-white/90 shadow-xl"
				>
					"Una experiencia que me motivó a especializarme"
				</div>
				<div
					class="relative max-w-[85%] self-start rounded-t-2xl rounded-br-2xl border border-white/20 bg-white/10 p-4 italic leading-relaxed text-white/90 shadow-xl"
				>
					"Aprendí más en 5 días que en meses de clases"
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.program-pricing-section {
		contain-intrinsic-size: 1px 500px;
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		const openBtn = document.getElementById('open-video-btn');
		const closeBtn = document.getElementById('close-video-btn');
		const modal = document.getElementById('video-modal') as HTMLDialogElement;
		const iframe = document.getElementById('youtube-iframe') as HTMLIFrameElement;
		const loader = document.getElementById('video-loader');
		
		const videoUrl = "https://www.youtube.com/embed/zYq7zPa_Cl0?autoplay=1";

		openBtn?.addEventListener('click', () => {
			if (iframe) {
				iframe.style.opacity = '0';
				if (loader) loader.style.display = 'flex';
				iframe.src = videoUrl;
			}
			modal?.showModal();
		});

		iframe?.addEventListener('load', () => {
			// Only fade in if we actually loaded a youtube URL (not the empty string on close)
			if (iframe.src && iframe.src !== window.location.href) {
				if (loader) loader.style.display = 'none';
				iframe.style.opacity = '1';
			}
		});

		const closeModal = () => {
			if (iframe) {
				iframe.src = ""; // Clear src to stop audio playing in background
				iframe.style.opacity = '0';
			}
			modal?.close();
		};

		closeBtn?.addEventListener('click', closeModal);
		
		// Close on backdrop click
		modal?.addEventListener('click', (e) => {
			const dialogDimensions = modal.getBoundingClientRect();
			if (
				e.clientX < dialogDimensions.left ||
				e.clientX > dialogDimensions.right ||
				e.clientY < dialogDimensions.top ||
				e.clientY > dialogDimensions.bottom
			) {
				closeModal();
			}
		});
	});
</script>
