---
// src/components/caep/Hero.astro
import { Image } from 'astro:assets'
import condorImg from '../../assets/characters/condor.png'
import saqraImg from '../../assets/characters/saqra-celeste.png'
---

<section
	class="relative flex min-h-dvh flex-col justify-center bg-cover bg-center pb-16 pt-28 [content-visibility:auto] md:pb-24 md:pt-36 lg:min-h-[90vh]"
	style="background-image: url('/images/mancora.jpg');"
>
	<!-- Gradient Overlay original morado / índigo -->
	<div
		class="absolute inset-0 bg-gradient-to-r from-[#2c1065]/90 via-[#2c1065]/60 to-transparent"
	>
	</div>

	<!-- Flying Condor (Desktop Only) -->
	<div class="animate-fly-in-condor absolute right-[10%] top-[10%] z-0 hidden w-[300px] lg:block">
		<div
			class="animate-float drop-shadow-[0_20px_30px_rgba(0,0,0,0.5)]"
			style="animation-delay: 3s;"
		>
			<Image
				src={condorImg}
				alt="Cóndor Andino volando"
				class="h-auto w-full drop-shadow-2xl transition-transform duration-500 hover:scale-105"
			/>
		</div>
	</div>

	<!-- Saqra (Desktop Only) -->
	<div
		class="animate-enter-up absolute bottom-[-10px] right-[10%] z-10 hidden w-[350px] origin-bottom delay-700 lg:block"
	>
		<div class="saqra-wrapper cursor-pointer">
			<Image
				src={saqraImg}
				alt="Saqra Cusqueño"
				class="h-auto w-full drop-shadow-[0_20px_30px_rgba(0,0,0,0.5)]"
			/>
		</div>
	</div>

	<div class="container relative z-10 mx-auto px-4 text-center md:text-left">
		<div
			class="mx-auto flex max-w-2xl flex-col items-center text-white md:mx-0 md:items-start md:pl-8"
		>
			<!-- Title Entrance -->
			<div class="animate-enter-up w-full delay-100 will-change-[transform,opacity]">
				<h1
					class="mb-2 text-4xl font-extrabold tracking-tight drop-shadow-lg sm:text-5xl md:text-6xl"
				>
					<span
						class="inline-block bg-gradient-to-b from-white via-slate-100 to-cyan-100 bg-clip-text text-transparent drop-shadow-[0_8px_18px_rgba(0,0,0,0.85)]"
						>CAEP PIURA
					</span>
					<span
						class="mt-1 block bg-gradient-to-b from-teal-200 via-emerald-400 to-cyan-500 bg-clip-text text-transparent drop-shadow-[0_4px_18px_rgba(16,185,129,0.55)] drop-shadow-[0_8px_25px_rgba(6,182,212,0.4)] sm:mt-0 sm:inline"
						>2027</span
					>
				</h1>
			</div>

			<!-- Glowing Separator Line Entrance -->
			<div class="relative mx-auto mb-6 mt-4 w-full max-w-lg delay-300 md:mx-0 md:w-4/5">
				<div
					class="absolute inset-y-0 left-0 w-full bg-gradient-to-r from-transparent via-emerald-400 to-transparent opacity-60 blur-[3px]"
				>
				</div>
				<div
					class="relative z-10 h-[2px] w-full bg-gradient-to-r from-transparent via-cyan-300 to-transparent shadow-[0_0_10px_rgba(6,182,212,0.8)]"
				>
				</div>
			</div>

			<!-- Subtitle Entrance -->
			<div class="mb-6 max-w-3xl text-center drop-shadow-md delay-500 md:text-left">
				<span
					class="mb-3 block bg-gradient-to-r from-emerald-300 via-teal-200 to-cyan-300 bg-clip-text text-sm font-extrabold uppercase tracking-[0.2em] text-transparent drop-shadow-[0_2px_10px_rgba(16,185,129,0.45)] md:text-base"
				>
					Psicología conexión total
				</span>
				<h2
					class="text-2xl font-bold tracking-wide text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.7)] md:text-3xl lg:text-4xl"
				>
					Psicología y Salud Integral
				</h2>
				<p
					class="mt-4 text-lg font-light leading-relaxed text-white/90 md:text-xl lg:text-2xl"
				>
					"Desde la investigación y el aprendizaje hacia la
					<strong
						class="bg-gradient-to-r from-emerald-300 via-teal-300 to-cyan-300 bg-clip-text font-bold text-transparent drop-shadow-[0_2px_8px_rgba(16,185,129,0.5)]"
						>práctica profesional"</strong
					>
				</p>
			</div>

			<!-- Event Details Entrance -->
			<div
				class="animate-enter-up mx-auto mb-10 flex w-fit flex-col items-start gap-6 drop-shadow-md delay-700 md:mx-0 md:w-auto md:flex-row md:items-center md:gap-8"
			>
				<div class="flex items-center gap-4">
					<div
						class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-yellow-400/30 bg-yellow-400/20 text-yellow-400 shadow-[0_0_15px_rgba(250,204,21,0.25)]"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-6 w-6 text-yellow-400"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
							></path>
						</svg>
					</div>
					<div class="flex flex-col text-left">
						<span class="text-xs font-bold uppercase tracking-wider text-white/60"
							>Cuándo</span
						>
						<span class="text-lg font-medium text-white drop-shadow-sm"
							>Del 14 al 19 de Noviembre, 2027</span
						>
					</div>
				</div>

				<!-- Separator y Dónde deshabilitados temporalmente -->
				<!--
				<div class="hidden h-10 w-[1px] bg-white/20 md:block"></div>

				<a
					href="https://maps.google.com/?q=Mancora,Piura,Peru"
					target="_blank"
					rel="noopener noreferrer"
					class="group flex items-center gap-4 transition-transform duration-300 hover:scale-[1.02]"
				>
					<div
						class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-yellow-400/20 text-yellow-400 transition-colors duration-300 group-hover:bg-yellow-400/40"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-6 w-6"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
							></path>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
						</svg>
					</div>
					<div class="flex flex-col text-left">
						<span class="text-xs font-bold uppercase tracking-wider text-white/50"
							>Dónde</span
						>
						<span
							class="text-lg font-medium text-white transition-colors duration-300 group-hover:text-yellow-200"
							>Máncora - Piura, Perú</span
						>
					</div>
				</a>
				-->
			</div>

			<!-- Buttons Entrance -->
			<div
				class="animate-enter-up mb-8 flex w-full flex-col justify-center gap-3 delay-700 sm:w-auto sm:flex-row sm:flex-wrap md:justify-start"
			>
				<!-- Primary Action -->
				<a
					href="https://app.caepperu.com/register"
					target="_blank"
					rel="noopener noreferrer"
					class="group inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full border border-pink-500/50 bg-gradient-to-r from-pink-600 to-rose-600 px-6 py-3.5 text-sm font-bold tracking-wider text-white shadow-[0_0_20px_rgba(225,29,72,0.4)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:from-pink-500 hover:to-rose-500 hover:text-white hover:shadow-[0_0_30px_rgba(225,29,72,0.6)]"
				>
					<svg
						class="h-5 w-5 shrink-0 transition-transform group-hover:translate-x-1"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2.5"
							d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
					</svg>
					<span class="whitespace-nowrap group-hover:text-white">INSCRÍBETE YA!</span>
				</a>

				<!-- WhatsApp Action -->
				<a
					target="_blank"
					href="https://api.whatsapp.com/send?phone=+51936202205&text=Hola%20CAEP%20quiero%20inscribirme%20en%20el%20congreso"
					class="group inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full border border-emerald-400/40 bg-gradient-to-r from-emerald-600/90 to-teal-600/90 px-6 py-3.5 text-sm font-bold tracking-wider text-white shadow-[0_0_20px_rgba(16,185,129,0.3)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:from-emerald-500 hover:to-teal-500 hover:text-white hover:shadow-[0_0_30px_rgba(16,185,129,0.5)]"
				>
					<svg
						class="h-5 w-5 shrink-0 transition-colors group-hover:text-white"
						fill="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
						></path>
					</svg>
					<span class="whitespace-nowrap group-hover:text-white">INFORMES</span>
				</a>

				<!-- Program Action comentado temporalmente -->
				<!--
				<a
					href="#programa"
					class="group inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full border border-amber-400/40 bg-gradient-to-r from-amber-500/80 to-yellow-500/80 px-6 py-3.5 text-sm font-bold tracking-wider text-white shadow-[0_0_20px_rgba(245,158,11,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:from-amber-400 hover:to-yellow-400 hover:text-white hover:shadow-[0_0_30px_rgba(245,158,11,0.4)]"
				>
					<svg
						class="h-5 w-5 shrink-0 transition-colors group-hover:text-white"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2.5"
							d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
						></path>
					</svg>
					<span class="whitespace-nowrap group-hover:text-white">VER PROGRAMA</span>
				</a>
				-->
			</div>

			<!-- Info Text Entrance -->
			<p
				class="animate-enter-up mt-4 flex w-full flex-wrap items-center justify-center gap-2 text-xs font-medium tracking-wide text-white/90 drop-shadow-md delay-700 sm:gap-3 sm:text-sm md:justify-start md:text-base"
			>
				<span>Cupos limitados</span>
				<span
					class="h-1.5 w-1.5 animate-ping rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(6,182,212,0.8)]"
				></span>
				<span>Certificación incluida</span>
				<span class="hidden h-1.5 w-1.5 rounded-full bg-white/40 sm:inline-block"></span>
				<span>Evento nacional</span>
			</p>
		</div>
	</div>
</section>

<style is:global>
	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-10px);
		}
	}
	.animate-float {
		animation: float 6s ease-in-out infinite;
	}

	@keyframes fly-in-condor {
		0% {
			transform: translate(-50vw, 20vh) scale(0.1) rotate(-15deg);
			opacity: 0;
		}
		50% {
			opacity: 1;
		}
		100% {
			transform: translate(0, 0) scale(1) rotate(0deg);
			opacity: 1;
		}
	}
	.animate-fly-in-condor {
		opacity: 0;
		animation: fly-in-condor 3s cubic-bezier(0.25, 1, 0.5, 1) forwards;
		animation-delay: 0.2s;
	}

	@keyframes gradient-x {
		0%,
		100% {
			background-size: 200% 200%;
			background-position: left center;
		}
		50% {
			background-size: 200% 200%;
			background-position: right center;
		}
	}
	.animate-gradient-x {
		animation: gradient-x 4s ease-in-out infinite;
	}

	@keyframes pulse-glow {
		0%,
		100% {
			opacity: 0.6;
			transform: scaleX(0.95);
		}
		50% {
			opacity: 1;
			transform: scaleX(1.05);
		}
	}
	.animate-pulse-glow {
		animation: pulse-glow 3s ease-in-out infinite;
		transform-origin: center;
	}
	@keyframes fade-in-up {
		0% {
			opacity: 0;
			transform: translateY(30px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}
	@keyframes scale-x-in {
		0% {
			opacity: 0;
			transform: scaleX(0);
		}
		100% {
			opacity: 1;
			transform: scaleX(1);
		}
	}

	.animate-enter-up {
		opacity: 0;
		animation: fade-in-up 0.8s ease-out forwards;
	}
	.animate-enter-line {
		opacity: 0;
		animation: scale-x-in 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
		transform-origin: center;
	}
	/* Delays for the cascading entrance effect */
	.delay-100 {
		animation-delay: 100ms;
	}
	.delay-300 {
		animation-delay: 300ms;
	}
	.delay-500 {
		animation-delay: 500ms;
	}
	.delay-700 {
		animation-delay: 700ms;
	}

	@keyframes dance {
		0%,
		100% {
			transform: rotate(0deg) translateY(0);
		}
		25% {
			transform: rotate(-3deg) translateY(-8px);
		}
		50% {
			transform: rotate(0deg) translateY(0);
		}
		75% {
			transform: rotate(3deg) translateY(-8px);
		}
	}
	@keyframes soft-zoom {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.05);
		}
	}
	.saqra-wrapper {
		transform-origin: bottom center;
		transition: transform 0.3s ease;
		animation: soft-zoom 4s ease-in-out infinite;
	}
	.saqra-wrapper:hover {
		animation: dance 2.2s ease-in-out infinite;
	}
</style>
