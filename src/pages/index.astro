---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - CAEP Components
import Hero from '../components/caep/Hero.astro'
import Features from '../components/caep/Features.astro'
import VideoSection from '../components/caep/VideoSection.astro'
import Speakers from '../components/caep/Speakers.astro'
import ProgramPricing from '../components/caep/ProgramPricing.astro'
import DiscoverFooter from '../components/caep/DiscoverFooter.astro'
import MissionVisionGallery from '../components/caep/MissionVisionGallery.astro'
import Organizaciones from '../components/caep/Organizaciones.astro'

// Content
// - SEO
const SEO = {
	title: 'CAEP PIURA 2027 | Psicología 360',
	description:
		'Congreso de Psicología 360: explora, aprende, evoluciona. Vive la experiencia CAEP en Piura 2027.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero />
	<Features />
	<VideoSection />
	<MissionVisionGallery />
	<Speakers />
	<ProgramPricing />
	<Organizaciones />
	<DiscoverFooter />
</Layout>
